{
  "name": "homesafe",
  "private": true,
  "version": "0.1.0",
  "description": "HomeSafe — school transport safety and tracking platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspace apps/api",
