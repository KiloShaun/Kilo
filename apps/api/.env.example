# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://homesafe:homesafe@localhost:5432/homesafe?schema=public
REDIS_URL=redis://localhost:6379

# Generate strong random values for these — do not reuse across environments.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12
INVITE_EXPIRES_IN_DAYS=7

# Comma-separated list of allowed CORS origins — one per web app (admin-web, driver-web, parent-web)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# GPS location freshness thresholds (seconds)
LOCATION_LIVE_WINDOW_SECONDS=45
LOCATION_STALE_WINDOW_SECONDS=300
